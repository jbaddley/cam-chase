# Copy to .env for local development: `cp .env.example .env`
#
# EXPO_PUBLIC_* values are inlined when Metro builds the bundle, so a change
# here needs `pnpm start --dev-client --clear` to take effect.
#
# None of these is a secret. They ship inside every copy of the app, and the
# API authorizes every request from a verified token regardless. The values
# below are the deployed dev stack (CDK outputs of PhotoChase-dev).
EXPO_PUBLIC_API_URL=https://yragu7zl51.execute-api.us-east-1.amazonaws.com
EXPO_PUBLIC_AUTH_DOMAIN=https://photochase-dev.auth.us-east-1.amazoncognito.com
EXPO_PUBLIC_USER_POOL_CLIENT_ID=4dplbp0cg2t06nf272ur32u2od

# Optional. Without it the app runs normally and offers nothing to buy.
EXPO_PUBLIC_REVENUECAT_KEY=test_KbtaAIgjGWlEOaOJVUEfNUrEOMD
