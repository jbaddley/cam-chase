{
  "cli": { "version": ">= 5.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE-ME.execute-api.us-east-1.amazonaws.com",
        "EXPO_PUBLIC_AUTH_DOMAIN": "https://photochase-dev.auth.us-east-1.amazoncognito.com",
        "EXPO_PUBLIC_USER_POOL_CLIENT_ID": "REPLACE-ME"
      },
      "ios": { "simulator": false },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE-ME.execute-api.us-east-1.amazonaws.com",
        "EXPO_PUBLIC_AUTH_DOMAIN": "https://photochase-dev.auth.us-east-1.amazoncognito.com",
        "EXPO_PUBLIC_USER_POOL_CLIENT_ID": "REPLACE-ME"
      },
      "android": { "buildType": "apk" }
    },
    "production": { "autoIncrement": true }
  },
  "submit": { "production": {} }
}
