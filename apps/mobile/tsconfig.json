{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["react"],
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["App.tsx", "index.ts", "src/**/*.ts", "src/**/*.tsx", "test/**/*.tsx", "vitest.config.ts"]
}
